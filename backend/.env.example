# Backend environment variables
# Copy to .env and adjust.

# Ex: sqlite fallback (leave empty to use SQLite file)
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/autoyt

# FastAPI settings (optional)
# PORT=8000
# HOST=0.0.0.0

# Celery/Redis (opcional)
# USE_CELERY=true
# REDIS_URL=redis://localhost:6379/0

# Object Storage (opcional S3/MinIO)
# USE_S3=false
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=autoyt
# S3_PREFIX=uploads/
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# S3_PRESIGN_TTL=3600
